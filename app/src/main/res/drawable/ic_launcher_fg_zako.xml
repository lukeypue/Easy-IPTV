<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft blue halo behind the mark. -->
    <path
        android:fillColor="#18366DA8"
        android:pathData="M18,20h72v72h-72z" />

    <!-- Clear geometric Z. The straight strokes are intentional: this must read as Z from across a room. -->
    <path
        android:pathData="M27,25 L88,25 L79,39 L61,39 L37,74 L85,74 L78,89 L19,89 L26,74 L50,39 L19,39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="23"
                android:startY="26"
                android:endX="84"
                android:endY="88"
                android:startColor="#195BFF"
                android:centerColor="#159CFF"
                android:endColor="#19E3D3"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Fine cyan edge light keeps the logo crisp on dark TV home screens. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#7DEBFF"
        android:strokeWidth="0.8"
        android:strokeLineJoin="round"
        android:pathData="M27,25 L88,25 L79,39 L61,39 L37,74 L85,74 L78,89 L19,89 L26,74 L50,39 L19,39 Z" />

    <!-- Recessed play symbol, integrated into the lower stroke. -->
    <path
        android:fillColor="#08101C"
        android:strokeColor="#75F0F0"
        android:strokeWidth="0.8"
        android:strokeLineJoin="round"
        android:pathData="M61,77 L74,81.5 L61,86 Z" />

    <!-- Small glossy highlight, kept subtle so the Z remains the hero. -->
    <path
        android:fillColor="#35FFFFFF"
        android:pathData="M29,28 L83,28 L79,32 L27,32 Z" />
</vector>
