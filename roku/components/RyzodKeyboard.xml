<?xml version="1.0" encoding="utf-8"?>
<component name="RyzodKeyboard" extends="Group">
  <interface>
    <field id="value" type="string" />
    <field id="title" type="string" value="Enter text" />
    <field id="password" type="boolean" value="false" />
    <field id="opened" type="boolean" alwaysNotify="true" onChange="openKeyboard" />
    <field id="done" type="boolean" alwaysNotify="true" />
    <field id="cancelled" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/core/Provider.brs" />
  <script type="text/brightscript" uri="pkg:/source/core/State.brs" />
  <script type="text/brightscript" uri="pkg:/source/core/Keyboard.brs" />
  <script type="text/brightscript" uri="pkg:/source/UI.brs" />
  <script type="text/brightscript" uri="pkg:/components/RyzodKeyboard.brs" />
  <children><Group id="body" /></children>
</component>
